+/** Logs startup operations and reports waits without changing their outcome. */
+async function traceStartup<T>(stage: string, operation: () => Promise<T>): Promise<T> {
+	console.info(`[vsc-light:desktop] ${stage}: start`);
+	const pending = setTimeout(() => console.warn(`[vsc-light:desktop] ${stage}: still waiting after 5 seconds`), 5000);
+	try {
+		const result = await operation();
+		console.info(`[vsc-light:desktop] ${stage}: complete`);
+		return result;
+	} catch (error) {
+		console.error(`[vsc-light:desktop] ${stage}: failed`, error, error instanceof Error ? error.stack : '');
+		throw error;
+	} finally {
+		clearTimeout(pending);
+	}
+}
